# 키 이름만 기록한다. 실제 값은 .env(커밋 금지) 또는 Render·Vercel 대시보드에 넣는다.
# 설명: docs/integrations.md

# ---- Backend (Spring Boot) ----
# Neon PostgreSQL — 로컬은 dev 브랜치, Render는 production 브랜치
# 직접 연결(non-pooled) 주소를 쓴다. Neon이 주는 URI를 JDBC 형식으로 바꿔 넣는다:
#   Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
#   JDBC: jdbc:postgresql://<host>/<db>?sslmode=require   (user·password는 아래 키로 분리)
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=

# Render 전용: Vercel 프론트 URL (쉼표 구분). 로컬 기본값은 http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Render 전용: prod (Dockerfile 기본값도 prod)
SPRING_PROFILES_ACTIVE=

# 토스페이먼츠 테스트 키 (PAY-04, 아직 미사용)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---- Backend DB 통합 테스트 (@Tag("db")) ----
# 로컬은 Neon dev 브랜치 값, CI는 ci.yml의 서비스 컨테이너 값. 비우면 DB 테스트를 건너뛴다.
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# ---- Frontend (Vite) — 로컬은 frontend/.env.local, 운영은 Vercel ----
# Render 백엔드 URL (로컬: http://localhost:8080)
VITE_API_BASE_URL=
